{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calr3/tdgauntlet/schema/move_response.schema.json",
  "title": "MoveResponse",
  "description": "Response body of POST /move. `move` is opaque and defined by the game.",
  "type": "object",
  "required": ["request_id", "move"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "move": {},
    "info": {
      "type": "object",
      "description": "Optional self-reporting. Recorded, never acted on. Extra keys are kept.",
      "properties": {
        "eval": { "type": ["number", "null"] },
        "depth": { "type": ["integer", "null"], "minimum": 0 },
        "nodes": { "type": ["integer", "null"], "minimum": 0 },
        "pv": { "type": "array" },
        "elapsed_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
