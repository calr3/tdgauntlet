{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calr3/tdgauntlet/schema/move_request.schema.json",
  "title": "MoveRequest",
  "description": "Request body of POST /move. `state` is opaque and defined by the game.",
  "type": "object",
  "required": ["protocol", "request_id", "game", "state", "context"],
  "properties": {
    "protocol": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "game": { "type": "string", "pattern": "^[a-z0-9_-]+/[0-9]+$" },
    "state": {},
    "budget": { "$ref": "budget.schema.json" },
    "context": {
      "type": "object",
      "required": ["match_id", "game_id", "ply", "side"],
      "properties": {
        "match_id": { "type": "string" },
        "game_id": { "type": "string" },
        "ply": { "type": "integer", "minimum": 0 },
        "side": { "enum": [0, 1] }
      }
    }
  }
}
